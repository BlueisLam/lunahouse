# Sao chép thành .dev.vars khi chạy local (wrangler). Trên Cloudflare Pages: Settings › Variables and Secrets.
# KHÔNG commit file .env lên GitHub.

# --- Supabase (Project settings › API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...        # service_role, tuyệt đối không đưa vào code phía trình duyệt

# --- Admin ---
ADMIN_PASSWORD=dat-mot-mat-khau-dai-tren-16-ky-tu
SESSION_SECRET=chuoi-ngau-nhien-it-nhat-32-ky-tu    # tạo bằng: openssl rand -hex 32

# --- Telegram (báo hồ sơ mới) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# --- Email (Resend) ---
RESEND_API_KEY=re_...
MAIL_FROM=Lunahouse <hello@lunahouse.click>        # chỉ dùng được sau khi verify domain trong Resend
ADMIN_NOTIFY_EMAIL=ban@gmail.com                   # email nhận báo hồ sơ mới
MAIL_REPLY_TO=ban@gmail.com                        # ứng viên bấm Reply sẽ về đây

# --- AI (Groq: đọc CV, chấm điểm matching, điền JD) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b                     # tên model Groq hay đổi, xem console.groq.com/docs/models
# GROQ_MODEL_FAST=                                 # tuỳ chọn: model rẻ hơn cho việc dán JD (mặc định = GROQ_MODEL)
# GROQ_VISION_MODEL=                               # tuỳ chọn: model đọc ảnh, để đọc CV dạng ảnh/scan. Bỏ trống = không đọc ảnh

# --- Khác ---
SITE_URL=https://lunahouse.click
